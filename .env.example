# Copy this file to .env.local and fill it in. Never commit .env.local.
#
# With no key set, the site still runs: the built-in example problems work
# and everything else shows a message saying the AI is not connected.

# The secret key from your AI provider. Server-side only: it is read in
# lib/ai/provider.ts and never reaches the browser.
# Do NOT rename it to start with NEXT_PUBLIC_.
AI_API_KEY=

# Which provider the key belongs to: gemini (default), anthropic or openai
AI_PROVIDER=gemini

# Optional. Overrides the default model
# (gemini-3.8-flash, claude-sonnet-5-5 or gpt-6.1-sol).
# Photo upload needs a model that accepts images.
# AI_MODEL=

# Optional. Only for a proxy or an OpenAI-compatible service.
# AI_BASE_URL=
